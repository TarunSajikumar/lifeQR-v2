{
  "name": "lifeqr",
  "version": "1.0.0",
  "description": "Emergency Medical QR Code System",
  "main": "backend/server.js",
  "scripts": {
    "start": "cd backend && node server.js",
    "dev": "cd backend && nodemon server.js",
    "install-all": "cd backend && npm install",
    "sync": "node scripts/sync-frontend.js",
    "sync:watch": "node scripts/sync-frontend.js --watch",
    "build-css": "node scripts/sync-frontend.js && npx tailwindcss -i ./website/src/input.css -o ./website/dist/output.css --minify && node scripts/sync-frontend.js"
  },
  "keywords": [
    "medical",
    "emergency",
    "qr-code",
    "healthcare"
  ],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": ">=16.0.0"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.1"
  }
}
